# Database (Docker PostgreSQL — independent from DESKA ERP)
POSTGRES_PORT=5434
POSTGRES_PASSWORD=replace-with-a-unique-random-database-password
DATABASE_URL=postgresql://deska:replace-with-a-unique-random-database-password@localhost:5434/deska_news
# JWT
JWT_SECRET=replace-with-at-least-32-random-characters
# Separate key for encrypting integration credentials; required in production
SETTINGS_ENCRYPTION_KEY=replace-with-another-32-character-random-value
# Optional one-time rotation key. Used only to decrypt settings encrypted with
# the previous key; remove after all affected integration settings are saved again.
SETTINGS_ENCRYPTION_KEY_PREVIOUS=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Tenancy
TENANT_MODE=multi
DEFAULT_TENANT_SLUG=default

# App URLs (DESKA ERP uses 3000/3001/5433)
API_URL=http://localhost:3101
NEXT_PUBLIC_API_URL=http://localhost:3101
PUBLIC_URL=http://localhost
APP_VERSION=1.0.0
WEB_PORT=3100
API_PORT=3101
# Bind Web to loopback when Nginx/Apache serves the public domain. Set to
# 0.0.0.0 only when direct access to WEB_PORT is intentionally required.
WEB_BIND_ADDRESS=127.0.0.1
# Optional prebuilt image namespace, e.g. ghcr.io/USERNAME/deskanews; leave empty for local build
IMAGE_PREFIX=deskanews
COMPOSE_PROJECT_NAME=deska-news
BASE_PATH=
# Production example: CORS_ORIGIN=https://app.deska.ir
CORS_ORIGIN=http://localhost:3100
# Number of trusted reverse-proxy hops in front of the API (Nginx = 1)
TRUST_PROXY_HOPS=1
PORT=3101

# Storage
STORAGE_TYPE=local
STORAGE_PATH=./uploads
# Seed admin (first run)
SEED_ADMIN_EMAIL=admin@deska.local
SEED_ADMIN_PASSWORD=replace-with-a-strong-one-time-bootstrap-password
SEED_ADMIN_NAME=مدیر سیستم

# Worker Deska (Telegram / X source fetch): configure only in Platform Admin → /platform/source-fetch
# Optional one-time bootstrap — migrated to platform DB on first API start, then ignored:
# SOURCE_FETCH_BRIDGE_URL=https://deska.<account>.workers.dev
# SOURCE_FETCH_BRIDGE_SECRET=
