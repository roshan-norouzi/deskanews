# نمونهٔ .env برای سرور production — کپی به:
# /www/wwwroot/deska.ir/app/.env
# مقادیر POSTGRES_PASSWORD، JWT_SECRET، SETTINGS_ENCRYPTION_KEY و SEED_ADMIN_PASSWORD را حتماً تصادفی و قوی بگذارید.

POSTGRES_PASSWORD=replace-with-strong-random-password
POSTGRES_PORT=5433
API_PORT=3001
WEB_PORT=3000
WEB_BIND_ADDRESS=127.0.0.1
BASE_PATH=

PUBLIC_URL=https://app.deska.ir
CORS_ORIGIN=https://app.deska.ir

JWT_SECRET=replace-with-at-least-32-random-characters
SETTINGS_ENCRYPTION_KEY=replace-with-another-32-character-random-value
SETTINGS_ENCRYPTION_KEY_PREVIOUS=

APP_VERSION=1.0.0
COMPOSE_PROJECT_NAME=deska-news
IMAGE_PREFIX=ghcr.io/roshan-norouzi/deskanews
REDIS_IMAGE=ghcr.io/roshan-norouzi/deskanews/redis:7-alpine
MINIO_IMAGE=ghcr.io/roshan-norouzi/deskanews/minio:latest

TRUST_PROXY_HOPS=1

SEED_ADMIN_EMAIL=admin@deska.local
SEED_ADMIN_PASSWORD=replace-with-strong-admin-password
SEED_ADMIN_NAME=مدیر سیستم
