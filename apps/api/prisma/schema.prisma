generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ PROJECTS & SMART PUBLISHING ============
model Project {
  id              String          @id @default(cuid())
  tenantId        String
  name            String
  description     String?
  status          String          @default("active")
  workType        String          @default("project")
  managerId       String?
  parentId        String?
  progressPercent Int             @default(0)
  budget          Decimal?        @db.Decimal(15, 2)
  cost            Decimal?        @db.Decimal(15, 2)
  revenue         Decimal?        @db.Decimal(15, 2)
  archivedAt      DateTime?
  startDate       DateTime?
  dueDate         DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  tasks           Task[]
  members         ProjectMember[]
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent          Project?        @relation("ProjectTree", fields: [parentId], references: [id], onDelete: SetNull)
  subProjects     Project[]       @relation("ProjectTree")

  @@index([tenantId, status])
}

model Task {
  id                  String          @id @default(cuid())
  tenantId            String
  projectId           String?
  title               String
  description         String?
  status              String          @default("todo")
  priority            String          @default("normal")
  assigneeId          String?
  dueDate             DateTime?
  parentId            String?
  recurrenceType      String          @default("none")
  recurrenceInterval  Int             @default(1)
  recurrenceStartDate DateTime?
  recurrenceRule      Json?
  sortOrder           Int             @default(0)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project             Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent              Task?           @relation("TaskTree", fields: [parentId], references: [id], onDelete: SetNull)
  subtasks            Task[]          @relation("TaskTree")
  checklist           ChecklistItem[]
  approvals           ApprovalStep[]

  @@index([tenantId, status])
  @@index([tenantId, projectId])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model ChecklistItem {
  id        String   @id @default(cuid())
  taskId    String
  title     String
  isDone    Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model ApprovalStep {
  id         String    @id @default(cuid())
  taskId     String
  approverId String
  stepOrder  Int
  status     String    @default("pending")
  comment    String?
  decidedAt  DateTime?
  createdAt  DateTime  @default(now())
  task       Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

/// @deprecated Retained read-only for lossless migration of installations that used the early generic publisher.
model PublishChannel {
  id        String           @id @default(cuid())
  tenantId  String
  name      String
  type      String
  endpoint  String?
  enabled   Boolean          @default(true)
  settings  Json             @default("{}")
  createdAt DateTime         @default(now())
  articles  PublishArticle[]
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, type])
}

/// @deprecated Retained read-only for lossless migration of installations that used the early generic publisher.
model PublishArticle {
  id          String          @id @default(cuid())
  tenantId    String
  channelId   String?
  title       String
  body        String
  status      String          @default("draft")
  scheduledAt DateTime?
  publishedAt DateTime?
  createdById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel     PublishChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, scheduledAt])
}

model NewsFeed {
  id             String          @id @default(cuid())
  tenantId       String
  name           String
  url            String
  sourceType     String          @default("rss")
  category       String          @default("عمومی")
  pollIntervalMinutes Int?
  autoPoll       Boolean?
  autoPrepare    Boolean?
  autoPublish    Boolean?
  autoSendSocial Boolean?
  purpose        String          @default("news-room")
  enabled        Boolean         @default(true)
  lastFetchedAt  DateTime?
  lastError      String          @default("")
  createdAt      DateTime        @default(now())
  articles       NewsArticle[]
  socialArticles SocialArticle[]
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, url])
  @@index([tenantId, enabled])
  @@index([tenantId, purpose])
}

model NewsArticle {
  id                    String                       @id @default(cuid())
  tenantId              String
  feedId                String?
  canonicalUrl          String
  originalUrl           String                       @default("")
  guid                  String                       @default("")
  originalTitle         String                       @default("")
  originalSummary       String                       @default("")
  originalContent       String                       @default("")
  originalContentIsFull Boolean                      @default(false)
  titleFa               String                       @default("")
  summaryFa             String                       @default("")
  contentFa             String                       @default("")
  featuredImageUrl      String                       @default("")
  status                String                       @default("new")
  sourceName            String                       @default("")
  publishedAtSource     DateTime?
  rejectedAt            DateTime?
  purgeAfter            DateTime?
  processingStartedAt   DateTime?
  publishedAt           DateTime?
  wordpressPostId       String                       @default("")
  wordpressPostUrl      String                       @default("")
  lastError             String                       @default("")
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  tenant                Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feed                  NewsFeed?                    @relation(fields: [feedId], references: [id], onDelete: SetNull)
  dailyReportItems      DailyReportItem[]
  dailyReportDecisions  DailyReportArticleDecision[]

  @@unique([tenantId, canonicalUrl])
  @@index([tenantId, status])
  @@index([status, purgeAfter])
}

model WordPressNewsEvaluation {
  id                  String   @id @default(cuid())
  tenantId            String
  wordpressPostId     Int
  postTitle           String   @default("")
  postUrl             String   @default("")
  wordpressModifiedAt DateTime?
  importance          String
  score               Int
  reason              String   @default("")
  newsValues          Json     @default("[]")
  source              String   @default("ai")
  evaluatedAt         DateTime @default(now())
  overriddenAt        DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, wordpressPostId])
  @@index([tenantId, importance, evaluatedAt])
}

model DailyReport {
  id         String                       @id @default(cuid())
  tenantId   String
  reportDate DateTime                     @db.Date
  status     String                       @default("draft")
  archivedAt DateTime?
  createdAt  DateTime                     @default(now())
  updatedAt  DateTime                     @updatedAt
  tenant     Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items      DailyReportItem[]
  decisions  DailyReportArticleDecision[]

  @@unique([tenantId, reportDate])
  @@index([tenantId, status])
}

model DailyReportArticleDecision {
  id        String      @id @default(cuid())
  tenantId  String
  reportId  String
  articleId String
  decision  String      @default("rejected")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  report    DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  article   NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([reportId, articleId])
  @@index([tenantId, decision])
  @@index([articleId])
}

model DailyReportItem {
  id                String       @id @default(cuid())
  tenantId          String
  reportId          String
  articleId         String?
  originalTitle     String
  originalUrl       String
  englishTitle      String       @default("")
  sourceName        String       @default("")
  sourcePublishedAt DateTime?
  segment           String       @default("Neutral")
  sourceTier        String       @default("Tier 1")
  bullets           Json         @default("[]")
  status            String       @default("pending")
  sortOrder         Int          @default(0)
  lastError         String       @default("")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  report            DailyReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  article           NewsArticle? @relation(fields: [articleId], references: [id], onDelete: SetNull)

  @@unique([reportId, articleId])
  @@index([tenantId])
  @@index([reportId, sortOrder])
}

/// @deprecated Replaced by NewsFeed.purpose = "social-studio"; retained until legacy data migration is verified.
model SocialFeed {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  url       String
  category  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model SocialArticle {
  id                       String    @id @default(cuid())
  tenantId                 String
  feedId                   String?
  title                    String
  link                     String
  author                   String?
  category                 String?
  publishedAt              DateTime?
  featuredImageUrl         String?
  generatedImageUrl        String?
  generatedImageTemplateId String?
  authorImageUrl           String?
  originalText             String?
  leadText                 String?
  summaryText              String?
  rewrittenText            String?
  shortUrl                 String?
  captionText              String?
  readingTime              Int?
  status                   String    @default("pending")
  processingStartedAt      DateTime?
  lastError                String    @default("")
  telegramSentAt           DateTime?
  instagramSentAt          DateTime?
  linkedinSentAt           DateTime?
  facebookSentAt           DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  tenant                   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feed                     NewsFeed? @relation(fields: [feedId], references: [id], onDelete: SetNull)

  @@unique([tenantId, link])
  @@index([tenantId, status])
  @@index([feedId])
}

// ============ EVENT MANAGEMENT ============

model EventManagementProject {
  id                  String                      @id @default(cuid())
  tenantId            String
  title               String
  type                String
  status              String                      @default("draft")
  objective           String
  organizationProfile String                      @default("private_company")
  mode                String                      @default("in_person")
  startAt             DateTime?
  endAt               DateTime?
  location            String?
  targetAudience      String?
  ownerId             String?
  approvedBudget      Decimal?                    @db.Decimal(15, 2)
  actualCost          Decimal?                    @db.Decimal(15, 2)
  details             Json                        @default("{}")
  calendarRisk        String                      @default("unassessed")
  calendarAssessment  Json?
  calendarCheckedAt   DateTime?
  createdById         String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  tenant              Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tasks               EventManagementTask[]
  agendaItems         EventManagementAgendaItem[]
  budgetItems         EventManagementBudgetItem[]

  @@index([tenantId, type, status])
  @@index([tenantId, startAt])
}

model EventManagementTask {
  id          String                 @id @default(cuid())
  tenantId    String
  projectId   String
  phase       String
  title       String
  deliverable String?
  ownerName   String?
  dueAt       DateTime?
  status      String                 @default("todo")
  required    Boolean                @default(false)
  sortOrder   Int                    @default(0)
  notes       String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project     EventManagementProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([tenantId, projectId, status])
  @@index([projectId, phase, sortOrder])
}

model EventManagementAgendaItem {
  id              String                 @id @default(cuid())
  tenantId        String
  projectId       String
  startAt         DateTime?
  durationMinutes Int
  title           String
  ownerName       String?
  onlineAction    String?
  technicalNotes  String?
  sortOrder       Int                    @default(0)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project         EventManagementProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([tenantId, projectId, sortOrder])
}

model EventManagementBudgetItem {
  id              String                 @id @default(cuid())
  tenantId        String
  projectId       String
  category        String
  description     String
  quantity        Decimal                @default(1) @db.Decimal(12, 2)
  unitCost        Decimal                @default(0) @db.Decimal(15, 2)
  estimatedAmount Decimal                @default(0) @db.Decimal(15, 2)
  actualAmount    Decimal?               @db.Decimal(15, 2)
  notes           String?
  sortOrder       Int                    @default(0)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project         EventManagementProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([tenantId, projectId, category])
}

// ============ PLATFORM CORE ============

model User {
  id                     String               @id @default(cuid())
  email                  String               @unique
  phone                  String?              @unique
  passwordHash           String
  name                   String
  role                   String               @default("user")
  status                 String               @default("active")
  avatarUrl              String?
  firstName              String?
  lastName               String?
  nationalId             String?
  fatherName             String?
  motherName             String?
  birthCertificateNumber String?
  birthCertificateDate   DateTime?            @db.Date
  birthDate              DateTime?            @db.Date
  maritalStatus          String?
  address                String?
  postalCode             String?
  mobilePhone            String?
  landlinePhone          String?
  bankAccountNumber      String?
  bankCardNumber         String?
  iban                   String?
  bankName               String?
  insuranceNumber        String?
  isActive               Boolean              @default(true)
  emailVerifiedAt        DateTime?
  lastLoginAt            DateTime?
  failedLoginAttempts    Int                  @default(0)
  lockedUntil            DateTime?
  passwordChangedAt      DateTime?
  sessionsInvalidatedAt  DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  refreshTokens          RefreshToken[]
  passwordResetTokens    PasswordResetToken[]
  tenantMembers          TenantMember[]
  receivedInvitations    TenantInvitation[]   @relation("TenantInvitationUser")
  createdTenants         Tenant[]             @relation("TenantCreatedBy")
  primaryOwnedTenants    Tenant[]             @relation("TenantPrimaryOwner")
  notifications          Notification[]
  auditLogs              AuditLog[]           @relation("AuditUser")
  activities             Activity[]           @relation("ActivityUser")
  employees              Employee[]
  userDocuments          UserDocument[]

  @@index([nationalId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model UserDocument {
  id           String   @id @default(cuid())
  userId       String
  kind         String
  name         String
  originalName String
  mimeType     String
  size         Int
  path         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@index([userId, createdAt])
}

model Tenant {
  id                      String                       @id @default(cuid())
  name                    String
  slug                    String                       @unique
  plan                    String                       @default("starter")
  status                  String                       @default("active")
  settings                Json                         @default("{}")
  locale                  String                       @default("fa-IR")
  isActive                Boolean                      @default(true)
  createdByUserId         String?
  primaryOwnerUserId      String?
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  createdBy               User?                        @relation("TenantCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  primaryOwner            User?                        @relation("TenantPrimaryOwner", fields: [primaryOwnerUserId], references: [id], onDelete: Restrict)
  members                 TenantMember[]
  modules                 TenantModule[]
  invitations             TenantInvitation[]
  projects                Project[]
  tasks                   Task[]
  publishChannels         PublishChannel[]
  publishArticles         PublishArticle[]
  newsFeeds               NewsFeed[]
  newsArticles            NewsArticle[]
  wordpressNewsEvaluations WordPressNewsEvaluation[]
  dailyReports            DailyReport[]
  dailyReportDecisions    DailyReportArticleDecision[]
  dailyReportItems        DailyReportItem[]
  socialFeeds             SocialFeed[]
  socialArticles          SocialArticle[]
  eventManagementProjects EventManagementProject[]
  eventManagementTasks    EventManagementTask[]
  eventManagementAgenda   EventManagementAgendaItem[]
  eventManagementBudgets  EventManagementBudgetItem[]
  customFieldDefinitions  CustomFieldDefinition[]
  customFieldValues       CustomFieldValue[]
  numberSequences         NumberSequence[]
  contacts                Contact[]
  contactBankAccounts     ContactBankAccount[]
  documentFolders         DocumentFolder[]
  documentFiles           DocumentFile[]
  calendarEvents          CalendarEvent[]
  auditLogs               AuditLog[]
  activities              Activity[]
  notifications           Notification[]
  automationJobs          AutomationJob[]
  integrationHealth       IntegrationHealth[]
  contentWorkflowEvents   ContentWorkflowEvent[]
  departments             Department[]
  employees               Employee[]
  jobOpenings             JobOpening[]

  @@index([status])
  @@index([createdByUserId])
  @@index([primaryOwnerUserId])
}

model TenantMember {
  tenantId      String
  userId        String
  role          String    @default("member")
  status        String    @default("active")
  jobTitle      String?
  metadata      Json      @default("{}")
  joinedAt      DateTime  @default(now())
  roleChangedAt DateTime?
  leftAt        DateTime?
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tenantId, userId])
  @@index([userId])
  @@index([tenantId, status])
}

model TenantInvitation {
  id              String    @id @default(cuid())
  tenantId        String
  email           String
  role            String    @default("member")
  token           String    @unique
  tokenHash       String?   @unique
  status          String    @default("pending")
  invitedByUserId String?
  invitedUserId   String?
  metadata        Json      @default("{}")
  expiresAt       DateTime
  accepted        Boolean   @default(false)
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedUser     User?     @relation("TenantInvitationUser", fields: [invitedUserId], references: [id], onDelete: Cascade)

  @@index([tenantId, email])
  @@index([tenantId, status])
  @@index([invitedUserId, status])
}

model ModuleDefinition {
  id            String         @id
  name          String
  domain        String
  version       String         @default("1.0.0")
  dependencies  String[]
  isCore        Boolean        @default(false)
  description   String?
  source        String         @default("builtin")
  packagePath   String?
  checksum      String?
  manifest      Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  tenantModules TenantModule[]
}

model TenantModule {
  tenantId String
  moduleId String
  enabled  Boolean          @default(false)
  settings Json             @default("{}")
  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module   ModuleDefinition @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([tenantId, moduleId])
}

model CustomFieldDefinition {
  id         String   @id @default(cuid())
  tenantId   String
  moduleId   String
  entityType String
  fieldName  String
  fieldLabel String
  fieldType  String
  options    Json?
  required   Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, entityType, fieldName])
  @@index([tenantId, entityType])
}

model CustomFieldValue {
  id           String    @id @default(cuid())
  tenantId     String
  entityType   String
  entityId     String
  fieldName    String
  valueText    String?
  valueNumber  Decimal?  @db.Decimal(18, 4)
  valueDate    DateTime?
  valueBoolean Boolean?
  valueJson    Json?
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, entityType, entityId, fieldName])
  @@index([tenantId, entityType, entityId])
}

model NumberSequence {
  id         String @id @default(cuid())
  tenantId   String
  code       String
  prefix     String @default("")
  suffix     String @default("")
  nextNumber Int    @default(1)
  padding    Int    @default(4)
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
}

// ============ CONTACTS ============

model Contact {
  id                 String               @id @default(cuid())
  tenantId           String
  type               String               @default("person")
  name               String
  firstName          String?
  lastName           String?
  email              String?
  phone              String?
  mobile             String?
  nationalId         String?
  economicCode       String?
  registrationNumber String?
  companyName        String?
  address            String?
  city               String?
  province           String?
  postalCode         String?
  website            String?
  notes              String?
  birthDate          DateTime?
  marriageDate       DateTime?
  membershipDate     DateTime?
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bankAccounts       ContactBankAccount[]
  employees          Employee[]

  @@unique([tenantId, nationalId])
  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, createdAt])
}

model ContactBankAccount {
  id            String  @id @default(cuid())
  tenantId      String
  contactId     String
  bankName      String
  accountNumber String?
  cardNumber    String?
  sheba         String?
  isDefault     Boolean @default(false)
  tenant        Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact       Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([contactId])
}

// ============ DOCUMENTS ============

model DocumentFolder {
  id        String           @id @default(cuid())
  tenantId  String
  name      String
  parentId  String?
  isSystem  Boolean          @default(false)
  systemKey String?
  createdAt DateTime         @default(now())
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent    DocumentFolder?  @relation("FolderTree", fields: [parentId], references: [id])
  children  DocumentFolder[] @relation("FolderTree")
  files     DocumentFile[]

  @@unique([tenantId, systemKey])
  @@index([tenantId])
}

model DocumentFile {
  id           String          @id @default(cuid())
  tenantId     String
  folderId     String?
  name         String
  originalName String
  mimeType     String
  size         Int
  path         String
  entityType   String?
  entityId     String?
  version      Int             @default(1)
  uploadedById String?
  createdAt    DateTime        @default(now())
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  folder       DocumentFolder? @relation(fields: [folderId], references: [id])

  @@index([tenantId])
  @@index([tenantId, entityType, entityId])
}

// ============ CALENDAR ============

model CalendarEvent {
  id             String                  @id @default(cuid())
  tenantId       String
  title          String
  description    String?
  startAt        DateTime
  endAt          DateTime
  allDay         Boolean                 @default(false)
  location       String?
  recurrenceType String                  @default("none")
  recurrenceRule Json?
  recurrenceCal  String                  @default("jalali")
  color          String?
  entityType     String?
  entityId       String?
  createdById    String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  tenant         Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attendees      CalendarEventAttendee[]

  @@index([tenantId, startAt])
}

model SystemCalendarObservance {
  id             String   @id @default(cuid())
  sourceKey      String   @unique
  title          String
  description    String?
  startAt        DateTime
  endAt          DateTime
  allDay         Boolean  @default(true)
  recurrenceType String   @default("yearly")
  recurrenceRule Json?
  recurrenceCal  String   @default("jalali")
  isHoliday      Boolean  @default(false)
  isActive       Boolean  @default(true)
  source         String   @default("university-of-tehran-1405")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([startAt])
  @@index([isActive])
}

model CalendarEventAttendee {
  id      String        @id @default(cuid())
  eventId String
  userId  String?
  email   String?
  name    String?
  status  String        @default("pending")
  event   CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

// ============ AUDIT & ACTIVITY ============

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  userId     String?
  action     String
  entityType String
  entityId   String
  changes    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?    @relation("AuditUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
}

model Activity {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String?
  type       String
  title      String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?    @relation("ActivityUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, entityType, entityId])
}

model Notification {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  title     String
  message   String
  type      String    @default("info")
  link      String?
  dedupeKey String?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, dedupeKey])
  @@index([userId, isRead])
  @@index([tenantId, userId, isRead, createdAt])
}

/// Durable, database-backed work queue. A nullable dedupe key allows completed
/// jobs to release their key while active and dead-letter jobs remain unique.
model AutomationJob {
  id          String    @id @default(cuid())
  tenantId    String
  type        String
  status      String    @default("queued")
  payload     Json      @default("{}")
  result      Json?
  dedupeKey   String?
  priority    Int       @default(0)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  availableAt DateTime  @default(now())
  startedAt   DateTime?
  lockedAt    DateTime?
  lockedBy    String?
  completedAt DateTime?
  lastError   String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type, dedupeKey])
  @@index([status, availableAt, priority])
  @@index([tenantId, status, createdAt])
}

/// Last known state of every external or operational integration.
model IntegrationHealth {
  id                  String    @id @default(cuid())
  tenantId            String
  key                 String
  type                String
  name                String
  status              String    @default("unknown")
  configured          Boolean   @default(true)
  consecutiveFailures Int       @default(0)
  latencyMs           Int?
  lastCheckedAt       DateTime?
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  lastError           String    @default("")
  metadata            Json      @default("{}")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId, status, updatedAt])
  @@index([type, status])
}

/// Append-only status history shared by newsroom and social-studio content.
model ContentWorkflowEvent {
  id         String   @id @default(cuid())
  tenantId   String
  entityType String
  entityId   String
  fromStatus String?
  toStatus   String
  stage      String
  action     String
  actorType  String   @default("system")
  actorId    String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId, createdAt])
}

// ============ INVENTORY ============

// ============ HR ============

model Department {
  id          String       @id @default(cuid())
  tenantId    String
  name        String
  parentId    String?
  managerId   String?
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees   Employee[]
  jobOpenings JobOpening[]

  @@index([tenantId])
}

model Employee {
  id                     String      @id @default(cuid())
  tenantId               String
  userId                 String?
  contactId              String?
  employeeCode           String
  departmentId           String?
  jobTitle               String?
  hireDate               DateTime?
  status                 String      @default("active")
  firstName              String?
  lastName               String?
  nationalId             String?
  fatherName             String?
  motherName             String?
  birthCertificateNumber String?
  birthCertificateDate   DateTime?   @db.Date
  birthDate              DateTime?   @db.Date
  maritalStatus          String?
  address                String?
  postalCode             String?
  mobilePhone            String?
  landlinePhone          String?
  bankAccountNumber      String?
  bankCardNumber         String?
  iban                   String?
  bankName               String?
  insuranceNumber        String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  tenant                 Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department             Department? @relation(fields: [departmentId], references: [id])
  user                   User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact                Contact?    @relation(fields: [contactId], references: [id])

  @@unique([tenantId, employeeCode])
  @@unique([tenantId, userId])
  @@unique([tenantId, nationalId])
  @@index([tenantId, nationalId])
  @@index([tenantId, mobilePhone])
  @@index([tenantId, status])
}

model JobOpening {
  id            String      @id @default(cuid())
  tenantId      String
  title         String
  department    String?
  departmentId  String?
  description   String?
  status        String      @default("open")
  createdAt     DateTime    @default(now())
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  departmentRef Department? @relation(fields: [departmentId], references: [id])
  applicants    Applicant[]

  @@index([tenantId, status])
}

model Applicant {
  id        String     @id @default(cuid())
  openingId String
  name      String
  email     String?
  phone     String?
  resumeUrl String?
  status    String     @default("new")
  notes     String?
  createdAt DateTime   @default(now())
  opening   JobOpening @relation(fields: [openingId], references: [id], onDelete: Cascade)
}
